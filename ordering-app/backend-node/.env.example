# ---------- Server ----------
PORT=3000
NODE_ENV=development

# Public URL of this API (used to build absolute image URLs if needed)
API_PUBLIC_URL=http://localhost:3000

# Comma-separated list of allowed frontend origins (CORS + Socket.IO)
CORS_ORIGINS=http://localhost:4200

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/ordering_app

# ---------- Auth ----------
# Use a long random string in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# Initial admin account (created automatically on first start / by `npm run seed`)
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=Admin@123

# ---------- Default shop settings (used only when settings don't exist yet) ----------
SHOP_NAME=My Milk Shop
SHOP_WHATSAPP=919876543210
SHOP_LAT=13.0827
SHOP_LNG=80.2707
SHOP_ADDRESS=Chennai, Tamil Nadu
FREE_KM=5
CHARGE_PER_KM=50

# ---------- Uploads ----------
MAX_UPLOAD_MB=5

# ---------- WhatsApp Cloud API (optional) ----------
# Leave blank to skip automatic sending. A Click-to-Chat link is always generated as a fallback.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Set to 1 when running behind a reverse proxy (nginx, Render, Heroku...)
TRUST_PROXY=
