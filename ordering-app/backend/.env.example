# Copy to .env and adjust. Double underscore "__" = nested setting (Jwt__Secret → Jwt:Secret).
# Real environment variables override this file. Non-secret defaults live in appsettings.json.

# ---------- Server ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
Cors__Origins=http://localhost:4200

# ---------- Data storage (JSON files, no database needed) ----------
# Folder for admins.json, items.json, orders.json, settings.json. Relative = inside the backend folder.
# Back this folder up regularly. Absolute paths work too, e.g. D:\MilkShopData
Storage__DataFolder=App_Data

# ---------- Auth ----------
# At least 32 characters. Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
Jwt__Secret=change-me-to-a-long-random-secret-at-least-32-chars
Jwt__ExpiresHours=12

# Admin account (created automatically on first start)
Admin__Username=Uthaya2026
Admin__Password=Uthaya2026@

# ---------- Default shop settings (used only the first time; then edit in Admin → Settings) ----------
Shop__Name="Uthaya Milk Products Industry (Pvt) Ltd Online Shopping Center"
Shop__WhatsApp=94770798107
Shop__Address=Urumpirai East, Jaffna
Shop__Lat=9.72
Shop__Lng=80.04
Shop__FreeKm=5
Shop__ChargePerKm=50
Shop__CurrencySymbol="Rs. "
Shop__DefaultCountryCode=94

# ---------- Uploads ----------
Uploads__MaxMb=5

# ---------- Automatic WhatsApp message to the shop on every new order ----------
# Messages go to the "Shop WhatsApp number" in Admin → Settings. Fill in ONE option (blank = off).
#
# Option A — CallMeBot (free, 2 minutes):
#   1. On the shop's phone, save +34 644 31 95 65 as a contact.
#   2. Send it this WhatsApp message:  I allow callmebot to send me messages
#   3. It replies with your API key — paste it here:
WhatsApp__CallMeBotApiKey=
#
# Option B — official Meta WhatsApp Cloud API (needs a Meta Business account + separate number):
WhatsApp__Token=
WhatsApp__PhoneNumberId=
WhatsApp__ApiVersion=v21.0

# ---------- Automatic email to the shop on every new order ----------
# Recipient(s) are set in Admin → Settings → "Order notification email". Blank Host = off.
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords)
#        and paste it below WITHOUT spaces.
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=
Email__Password=
# Optional: sender address (defaults to Username) and display name
Email__From=
Email__FromName=Milk Shop Orders

# true when running behind nginx / IIS / a load balancer
TrustProxy=false
